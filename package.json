{
	"name": "tailwindcss-flow-type",
	"version": "0.1.0",
	"description": "A Tailwind CSS plugin for fluid, responsive typography that scales smoothly across screen sizes with minimal configuration.",
	"keywords": [
		"tailwindcss",
		"v4",
		"fluid",
		"typography"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MarioMH8/tailwindcss-flow-type.git"
	},
	"homepage": "https://github.com/MarioMH8/tailwindcss-flow-type",
	"bugs": {
		"url": "https://github.com/MarioMH8/tailwindcss-flow-type/issues"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": "./dist/index.js"
		},
		"./core": {
			"import": {
				"types": "./dist/core/index.d.ts",
				"default": "./dist/core/index.js"
			},
			"require": {
				"types": "./dist/core/index.d.cts",
				"default": "./dist/core/index.cjs"
			},
			"default": "./dist/core/index.js"
		},
		"./plugin": {
			"import": {
				"types": "./dist/plugin/index.d.ts",
				"default": "./dist/plugin/index.js"
			},
			"require": {
				"types": "./dist/plugin/index.d.cts",
				"default": "./dist/plugin/index.cjs"
			},
			"default": "./dist/plugin/index.js"
		},
		"./preset/default.css": "./dist/preset/default.css"
	},
	"scripts": {
		"build": "tsup",
		"commitlint": "commitlint --edit",
		"demo": "vite --config demo/vite.config.ts",
		"demo:build": "vite build --config demo/vite.config.ts",
		"lint": "eslint --cache .",
		"lint:ci": "eslint --cache --cache-strategy content .",
		"lint:fix": "eslint --cache --fix .",
		"prepare": "husky",
		"prepublishOnly": "bun run build",
		"test": "bun run build && bun test",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"tailwindcss": "^4.0.0"
	},
	"devDependencies": {
		"@changesets/cli": "2.31.1",
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@hexadrop/eslint-config": "1.0.6",
		"@hexadrop/tsconfig": "0.0.5",
		"@tailwindcss/postcss": "4.3.3",
		"@tweakpane/core": "2.0.5",
		"@types/bun": "1.3.14",
		"eslint": "10.8.0",
		"husky": "9.1.7",
		"lint-staged": "17.3.0",
		"postcss": "8.5.25",
		"tailwindcss": "4.3.3",
		"tsup": "8.5.1",
		"tweakpane": "4.0.5",
		"typescript": "6.0.3",
		"vite": "8.2.0"
	}
}
