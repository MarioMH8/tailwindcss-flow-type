{
	"extends": "@hexadrop/tsconfig",
	"compilerOptions": {
		"baseUrl": ".",
		"ignoreDeprecations": "6.0",
		"paths": {
			"@/*": [
				"./src/*"
			],
			"@e2e/*": [
				"./e2e/*"
			],
			"@flow/*": [
				"./src/*"
			]
		},
		"types": [
			"bun"
		]
	},
	"exclude": ["node_modules", "dist", "demo/dist"]
}
